# .sigil — このプロジェクトのコンテナに渡すもの（プロジェクト直下に置く）
#
# env <名前>          ホストの環境変数をそのまま渡す。値はここに書かない。
#                     .env に op:// 参照を書いておけば、sigil が 1Password から読み込みます。
# port <番号>         127.0.0.1:<番号> をコンテナの同じ番号へ
# port <ホスト>:<コンテナ>
#
# 内容が変わると、次にコンテナを作るときに確認を求められます。
# 変更を反映するには sigil stop してから sigil。

env DATABASE_URL
env STRIPE_SECRET_KEY

port 5173        # Vite
port 3000        # Next.js など
port 8080:80     # PHP の開発サーバーなど
