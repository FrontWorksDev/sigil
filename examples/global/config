# ~/.config/sigil/config — すべてのプロジェクトのコンテナに渡すもの
# 書き方はプロジェクトの .sigil と同じ（env / port）。
# ホスト側のファイルなので、確認なしで使われます。
#
# 値は同じフォルダの secrets.env に 1Password かキーチェーンの参照として書く。

env WAKATIME_API_KEY

# キーチェーンから読むときの専用キーチェーン（この全体設定でだけ書ける。~/Library/Keychains/ の直下に置く）
# keychain ~/Library/Keychains/sigil.keychain-db

# .sigil の ro（読み取り専用のマウント）で指してよい範囲（この全体設定でだけ書ける）
# 他人のコードに見せてよいリポジトリの置き場だけを書く
# ro_root ~/src
