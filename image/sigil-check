#!/usr/bin/env bash
# sigil-check — コンテナの中から、隔離が効いているかを確認する
# 使い方（ホストから）:  sigil check
set -u

# 色は、標準出力が端末で、NO_COLOR がないときだけ付ける（パイプやリダイレクトでは素のテキスト）。
# ホストで色を止めているときは、sigil check が NO_COLOR=1 を渡してくる。
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  c_ok=$'\e[38;5;114m' c_ng=$'\e[38;5;203m' c_warn=$'\e[38;5;221m' c_head=$'\e[38;5;141m'
  c_dim=$'\e[2m' c_bold=$'\e[1m' c_off=$'\e[0m'
else
  c_ok='' c_ng='' c_warn='' c_head='' c_dim='' c_bold='' c_off=''
fi

pass=0
fail=0
ok()   { printf '  %s✓%s %s\n' "$c_ok" "$c_off" "$1"; pass=$((pass + 1)); }
ng()   { printf '  %s✗%s %s\n' "$c_ng" "$c_off" "$1"; fail=$((fail + 1)); }
# 注意: 隔離は保たれているが、見直したほうがよいもの（トークンの期限など）。失敗には数えない
warns=0
warn() { printf '  %s!%s %s\n' "$c_warn" "$c_off" "$1"; warns=$((warns + 1)); }
# 見出し: 世界観の言葉に、普通の言葉での意味を添える
section() { printf '\n%s■ %s%s %s── %s%s\n' "$c_head" "$1" "$c_off" "$c_dim" "$2" "$c_off"; }
expect_absent() { if [ -e "$1" ]; then ng "$2 が見えている ($1)"; else ok "$2 は見えない"; fi; }

printf '\n  %s⟡ 結界の点検%s %s（コンテナの隔離が効いているかの確認）%s\n' "$c_bold" "$c_off" "$c_dim" "$c_off"

section "禁忌の扉" "ホストの秘密情報が見えないこと"
expect_absent "$HOME/.ssh"          "SSH 鍵 (~/.ssh)"
expect_absent "$HOME/.aws"          "AWS 設定 (~/.aws)"
expect_absent "$HOME/.config/op"    "1Password CLI 設定"
expect_absent "$HOME/.gitconfig"    "ホストの .gitconfig"
expect_absent "$HOME/.npmrc"        "ホストの .npmrc"
expect_absent "$HOME/.docker"       "Docker の認証情報"
expect_absent /var/run/docker.sock  "Docker ソケット"
if [ -n "${SSH_AUTH_SOCK:-}" ]; then ng "SSH エージェントが転送されている"; else ok "SSH エージェントは転送されていない"; fi
if command -v ssh >/dev/null 2>&1; then ng "ssh コマンドが入っている"; else ok "ssh コマンドは入っていない"; fi

section "結界" "ホストで実行されるファイルを書き換えられないこと"
proj="${SIGIL_PROJECT_DIR:-/workspace}"
if [ -e "$proj/.git" ]; then
  if touch "$proj/.git/.sigil-write-test" 2>/dev/null; then
    rm -f "$proj/.git/.sigil-write-test"; ng ".git に書き込める（hooks を仕込まれる恐れ）"
  else
    ok ".git は読み取り専用"
  fi
else
  ng ".git がない（ホスト側で git init / clone してから sigil を起動してください）"
fi
if [ -d "$HOME/.config/nvim" ]; then
  if touch "$HOME/.config/nvim/.sigil-write-test" 2>/dev/null; then
    rm -f "$HOME/.config/nvim/.sigil-write-test"; ng "Neovim 設定に書き込める"
  else
    ok "Neovim 設定は読み取り専用"
  fi
fi

section "権能の剥奪" "権限"
if [ "$(id -u)" = "0" ]; then ng "root で動いている"; else ok "一般ユーザー ($(id -un)) で動いている"; fi
capeff="$(awk '/^CapEff/ {print $2}' /proc/self/status)"
if [ "$capeff" = "0000000000000000" ]; then ok "Linux capabilities はすべて外れている"; else ng "capabilities が残っている ($capeff)"; fi
if grep -q '^NoNewPrivs:[[:space:]]*1' /proc/self/status; then ok "no-new-privileges が有効"; else ng "no-new-privileges が無効"; fi

section "持ち込むもの" "渡されている環境変数（名前のみ）"
extra="$(env | cut -d= -f1 | grep -vE '^(PATH|HOME|HOSTNAME|TERM|COLORTERM|LANG|LC_ALL|PWD|OLDPWD|SHLVL|_|USER|LOGNAME|SHELL|GOPATH|CARGO_HOME|RUSTUP_HOME|NPM_CONFIG_PREFIX|npm_config_cache|CLAUDE_CONFIG_DIR|DISABLE_AUTOUPDATER|GH_NO_UPDATE_NOTIFIER|EDITOR|SIGIL|SIGIL_PROJECT_DIR|GIT_CONFIG_COUNT|GIT_CONFIG_KEY_0|GIT_CONFIG_VALUE_0|DEBIAN_FRONTEND|PS1|LS_COLORS|MAIL|NO_COLOR|BASH_.*|COLUMNS|LINES|.*_PROXY|.*_proxy|PHPIZE_DEPS|PHP_INI_DIR|PHP_CFLAGS|PHP_CPPFLAGS|PHP_LDFLAGS|GPG_KEYS|PHP_VERSION|PHP_URL|PHP_ASC_URL|PHP_SHA256)$' | sort || true)"
if [ -n "$extra" ]; then printf '    %s\n' $extra; else echo "    （なし）"; fi

# GitHub のトークン（issue #12）。コンテナに渡したトークンは、プロジェクトのコードからも読めるので、
# 安全さはトークンに許す権限で決まる。ここでは確実に分かることだけを確かめる:
#   - 種類（先頭の文字列）: classic PAT と OAuth のトークンは、対象のリポジトリを絞れない
#   - 期限（API の応答ヘッダー）: 長すぎる・ないときは注意
# 権限そのもの（Contents の書き込みなど）は、書き込みを試さないと分からないので確かめない
# （点検のために書き込みの API を呼ぶのは危ない）。README の手順で、人の手で一度確かめる。
# トークンの値は表示しない。gh へも環境変数で渡し、コマンドラインには載せない
# （export は bash の組み込みなので、値がほかのプロセスの引数として見えない）。
check_gh_token() {
  local name="$1" tok="${!1}"
  case "$tok" in
    github_pat_*) ok "$name は fine-grained PAT" ;;
    ghp_*) ng "$name は classic PAT（対象のリポジトリを絞れない）。fine-grained PAT にしてください" ;;
    gho_*) ng "$name は OAuth のトークン（gh auth login などで作られ、リポジトリを絞れない）。fine-grained PAT にしてください" ;;
    *) warn "$name のトークンの種類が分からない（fine-grained PAT を勧めます）" ;;
  esac

  if ! command -v gh >/dev/null 2>&1; then
    warn "gh が見つからないので、$name の期限を確かめられない"
    return
  fi
  # /rate_limit は、回数の制限に数えられない。応答ヘッダーだけを使い、本文は見ない。
  # GH_TOKEN と GITHUB_TOKEN の両方があると gh は GH_TOKEN を使うので、確かめる 1 つだけを渡す。
  local res status exp ts now days day
  res="$(unset GH_TOKEN GITHUB_TOKEN; export GH_TOKEN="$tok"; timeout 10 gh api -i /rate_limit 2>/dev/null)"
  res="${res//$'\r'/}"
  status="$(printf '%s\n' "$res" | head -1 | awk '/^HTTP/ {print $2}')"
  case "$status" in
    200) ;;
    401) ng "$name は GitHub に拒否された（無効か、期限が切れている）"; return ;;
    "") warn "GitHub に問い合わせられないので、$name の期限を確かめられない"; return ;;
    *) warn "GitHub の応答が $status なので、$name の期限を確かめられない"; return ;;
  esac

  exp="$(printf '%s\n' "$res" | grep -i '^github-authentication-token-expiration:' | head -1 | cut -d: -f2-)"
  if [ -z "$exp" ]; then
    warn "$name に期限がない。30〜90 日の期限を付けて作り直してください"
    return
  fi
  # 応答の値は表示しない（読めなかったときも）。日付は解釈した結果から作り直して出す
  if ! ts="$(date -u -d "$exp" +%s 2>/dev/null)"; then
    warn "$name の期限を読み取れない"
    return
  fi
  now="$(date -u +%s)"
  days=$(( (ts - now) / 86400 ))
  day="$(date -u -d "@$ts" +%Y-%m-%d)"
  if [ "$ts" -le "$now" ]; then
    ng "$name の期限が切れている（$day）"
  elif [ "$days" -le 7 ]; then
    warn "$name の期限まであと $days 日（$day）。そろそろ作り直してください"
  elif [ "$days" -gt 90 ]; then
    warn "$name の期限まであと $days 日（$day）。30〜90 日にすると、漏れたときの影響を抑えられます"
  else
    ok "$name の期限まであと $days 日（$day）"
  fi
}

if [ -n "${GH_TOKEN:-}" ] || [ -n "${GITHUB_TOKEN:-}" ]; then
  section "外界の鍵" "GitHub のトークン（値は表示しない）"
  for n in GH_TOKEN GITHUB_TOKEN; do
    if [ -n "${!n:-}" ]; then check_gh_token "$n"; fi
  done
fi

section "ツール" "コンテナ内のコマンドと版"
for c in nvim node npm go cargo php composer python3 uv claude gh wakatime-cli tree-sitter rg fd lua5.1 luarocks lazygit bat delta; do
  if command -v "$c" >/dev/null 2>&1; then
    # go は version サブコマンド、lua5.1 は -v（標準エラーに出す）で版を出す
    case "$c" in
      go) v="$(go version 2>/dev/null)" ;;
      lua5.1) v="$(lua5.1 -v 2>&1 | head -1)" ;;
      *) v="$("$c" --version 2>/dev/null | head -1)" ;;
    esac
    printf '    %-12s %s\n' "$c" "$v"
  else
    printf '    %-12s %s見つからない%s\n' "$c" "$c_warn" "$c_off"
  fi
done

echo
note=""
if [ "$warns" -gt 0 ]; then note="、注意: $warns"; fi
if [ "$fail" -eq 0 ]; then
  printf '%s✔ 結界は完全です%s %s── すべて OK (%d 項目%s)%s\n' "$c_ok" "$c_off" "$c_dim" "$pass" "$note" "$c_off"
else
  printf '%s✗ 結界に綻びがあります%s ── %d 項目に問題あり（OK: %d%s）\n' "$c_ng" "$c_off" "$fail" "$pass" "$note"
  exit 1
fi
